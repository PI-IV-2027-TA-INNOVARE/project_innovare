# Endereco da API do backend (Django). Usado quando VITE_AUTH_MOCK=false.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ---------------------------------------------------------------------------
# MODO DEMONSTRACAO
# ---------------------------------------------------------------------------
# true  -> autentica com usuarios ficticios, sem backend e sem banco de dados.
#          Use apenas para navegar pelo front localmente.
# false -> autentica de verdade contra VITE_API_BASE_URL (comportamento padrao).
#
# As credenciais ficticias aparecem na propria tela de login e estao definidas
# em src/services/mockAuth.js. Nunca ligue isto em ambiente exposto.
VITE_AUTH_MOCK=false
