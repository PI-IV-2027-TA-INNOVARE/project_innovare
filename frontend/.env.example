# --- API ---------------------------------------------------------------------
# Endereco da API do Django. O backend sobe em 8000 por padrao e serve tudo sob
# /api/. Precisa bater com CORS_ALLOWED_ORIGINS do backend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Modo demonstracao -------------------------------------------------------
# true  -> autentica com usuarios ficticios, sem backend e sem banco. Serve
#          para navegar pelo front localmente; as credenciais aparecem na
#          propria tela de login (src/services/mockAuth.js).
# false -> autentica de verdade contra VITE_API_BASE_URL. E o padrao.
#
# Nunca ligue o modo demonstracao em ambiente exposto.
VITE_AUTH_MOCK=false
