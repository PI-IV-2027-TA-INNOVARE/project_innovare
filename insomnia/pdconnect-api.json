        {
          "name": "Logout - poe o refresh na blacklist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout",
                ""
              ]
            },
            "description": "`POST /api/auth/logout/` - encerra a sessao de verdade.\n\nLimpar o token no navegador nao encerra sessao nenhuma: quem tiver copiado\no refresh continua renovando o acesso ate ele expirar. Aqui o refresh entra\nna blacklist do SimpleJWT e para de valer na hora (PB02).\n\noperationId: auth_logout_create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Perfil autenticado e permissoes efetivas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile",
                ""
              ]
            },
            "description": "`GET /api/auth/profile/` - o usuario autenticado e o seu `papel`.\n\nE daqui que o front descobre qual dos quatro atores esta na sessao.\n\noperationId: auth_profile_retrieve"
          }
        },
        {
          "name": "Redefine a senha pelo token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password",
                ""
              ]
            },
            "description": "`POST /api/auth/reset-password/` - vale para recuperacao e primeiro acesso.\n\noperationId: auth_reset_password_create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"\",\n  \"nova_senha\": \"\",\n  \"confirmar_senha\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - emite access e refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token",
                ""
              ]
            },
            "description": "`POST /api/auth/token/` - par de tokens a partir de e-mail e senha.\n\noperationId: auth_token_create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.access) { pm.collectionVariables.set('access_token', corpo.access); }",
                  "if (corpo.refresh) { pm.collectionVariables.set('refresh_token', corpo.refresh); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Renova o access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "`POST /api/auth/token/refresh/`.\n\noperationId: auth_token_refresh_create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "if (corpo.access) { pm.collectionVariables.set('access_token', corpo.access); }",
                  "if (corpo.refresh) { pm.collectionVariables.set('refresh_token', corpo.refresh); }"
                ]
              }
            }
          ]
        }
      ]
