# O pedido que segue para o gunicorn.
#
# X-Forwarded-For e trocado pelo endereco que chegou ao nginx, e nao somado ao
# que o cliente mandou: com NUM_PROXIES=1 a API conta os limites por esse
# endereco, e um cabecalho forjado escaparia da trava de tentativas.
# X-Forwarded-Proto diz ao Django que o pedido veio por HTTPS
# (SECURE_PROXY_SSL_HEADER); sem ele, o redirecionamento para HTTPS entra em laco.

proxy_pass $api;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Real-IP $remote_addr;

# O gunicorn espera a IA por ate 120 s; o nginx espera um pouco mais.
proxy_connect_timeout 5s;
proxy_send_timeout 130s;
proxy_read_timeout 130s;
