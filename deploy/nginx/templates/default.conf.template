# O nginx da frente do P&D Connect. Na subida, a imagem oficial troca
# ${DOMINIO} e ${ADMIN_URL} pelos valores do deploy/.env e grava o resultado em
# /etc/nginx/conf.d/default.conf. As variaveis do proprio nginx ($host,
# $remote_addr...) ficam como estao: o filtro do compose so deixa trocar essas
# duas.

server_tokens off;

gzip on;
gzip_min_length 1024;
gzip_types text/css application/javascript image/svg+xml;

limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=por_endereco:10m;
limit_conn_status 429;

resolver 127.0.0.11 valid=10s ipv6=off;

# O caminho do certificado com variavel faz o nginx le-lo a cada conexao, e nao
# na subida: o nginx sobe antes do primeiro certificado existir (o desafio do
# Let's Encrypt passa por ele) e pega a renovacao sem recarregar.
map $host $certificado_do_site {
    default ${DOMINIO};
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${DOMINIO};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate /etc/letsencrypt/live/$certificado_do_site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$certificado_do_site/privkey.pem;
    ssl_certificate_cache max=4 valid=1h;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # O anexo vai ate ANEXO_TAMANHO_MAXIMO_MB (10 MB) mais o envelope do envio;
    # o limite exato continua na API, que responde com a mensagem certa.
    client_max_body_size 11m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 30s;
    limit_conn por_endereco 40;

    root /usr/share/nginx/html;

    set $api http://backend:8000;

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/conf.d/para-a-api.inc;
    }

    location /${ADMIN_URL}/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/conf.d/para-a-api.inc;
    }

    location /static/ {
        alias /srv/static/;
        include /etc/nginx/conf.d/cabecalhos.inc;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location /assets/ {
        include /etc/nginx/conf.d/cabecalhos.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /fonts/ {
        include /etc/nginx/conf.d/cabecalhos.inc;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/conf.d/cabecalhos.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
