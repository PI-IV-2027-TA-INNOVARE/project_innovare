# =============================================================================
# P&D Connect - variaveis do compose de producao (deploy/compose.producao.yml)
#
# Copie para deploy/.env no servidor e preencha. O deploy/.env NUNCA entra no
# git. Os segredos da aplicacao (SECRET_KEY, banco, e-mail, chaves de IA) ficam
# no backend/.env, e nao aqui.
# =============================================================================

# O endereco do site, sem https:// e sem barra. Ex.: pdconnect.ac2.com.br
# Vira o ALLOWED_HOSTS, o CORS e o FRONTEND_URL da API, o server_name do nginx
# e o nome do certificado.
DOMINIO=

# O caminho do /admin/ do Django, sem barras. O padrao "admin" e recusado em
# producao. Ex.: painel-tecnico-7f3a
ADMIN_URL=

# Senha do Redis. Use so letras e numeros, porque ela vai dentro de um endereco
# redis://. Gere com: openssl rand -hex 32
REDIS_SENHA=

# E-mail que o Let's Encrypt avisa quando o certificado estiver para vencer.
CERTBOT_EMAIL=
