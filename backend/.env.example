# =============================================================================
# P&D Connect - backend (Django)
#
# Copie para `.env` e preencha. O `.env` NUNCA entra no git (AGENTS.md 0.1):
# ele carrega credenciais reais de banco, SMTP e IA. Este arquivo, sim, e
# versionado - portanto nao coloque nenhum valor real aqui.
#
# As chaves numericas nao aceitam valor vazio: o `decouple` so usa o padrao do
# `settings.py` quando a chave NAO existe. Vazia, ele le string vazia e a subida
# quebra com ValueError. Se nao for definir uma delas, comente a linha inteira.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
#
# `local` ou `producao`. Governa o acesso ao banco: TLS (`require` em
# producao, `prefer` em local) e reaproveitamento de conexao
# (`DB_CONN_MAX_AGE`). Valor desconhecido impede a subida - ver
# `core/configuracao.py`.
#
# Nao governa o `DEBUG`: a ausencia de AMBIENTE nao pode ligar o modo de
# depuracao, porque quem esquece de declarar o ambiente num deploy e justamente
# quem nao pode receber traceback na resposta de erro.
#
# E declarado, nao inferido do `DB_HOST`: um tunel local para o banco remoto
# pareceria producao, e um Postgres gerenciado com DNS proprio pareceria local.
#
# Ausente, vale `local` - o padrao seguro para quem acabou de clonar.
#
# `producao` com `DEBUG=True` impede a subida: era o `.env` de desenvolvimento
# apontado para o banco de verdade, com a pagina de erro detalhada aberta.
# Desenvolvimento e teste usam o Postgres local com dados ficticios; o banco
# remoto (Neon) e de homologacao, com `DEBUG=False`.
AMBIENTE=

# --- Django ------------------------------------------------------------------
# Gere com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Obrigatoria com DEBUG=False: sem chave propria a aplicacao recusa subir.
SECRET_KEY=
# True ou False. Ausente, vale False - o lado seguro, independente do AMBIENTE.
# Com `DEBUG=False` o runserver para de servir `/media/` (anexos, PB21) e os
# assets do Swagger: em deploy quem serve isso e o servidor web, nao o Django.
DEBUG=
# Separados por virgula. Ex.: localhost,127.0.0.1
ALLOWED_HOSTS=
# Ex.: America/Sao_Paulo
TIME_ZONE=
# DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=

# Origens do front autorizadas a chamar a API (Vite sobe em 5173).
# Separadas por virgula. Ex.: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

# O token de renovacao da sessao vai num cookie que o JavaScript nao le.
# Referencia: Lax, para front e API no mesmo site - o mesmo dominio, ou o proxy
# do Vite em desenvolvimento (`VITE_API_BASE_URL=/api` no front). Em dominios
# diferentes, None, que o navegador so aceita com HTTPS. Com AMBIENTE=producao
# e DEBUG=False, o cookie sai so por HTTPS.
AUTH_COOKIE_SAMESITE=

# --- Banco de dados ----------------------------------------------------------
#
# DESENVOLVIMENTO E TESTE: PostgreSQL LOCAL, com dados ficticios ou
# anonimizados (premissa do TAP e da Declaracao de Escopo). O Neon nao e banco
# de desenvolvimento.

DB_NAME=
DB_USER=
DB_PASSWORD=
# No local, 127.0.0.1.
DB_HOST=
# Numero. O Postgres responde na 5432.
DB_PORT=
# `prefer` no local; `require` em host remoto, que exige TLS. Ausente, segue o
# AMBIENTE.
DB_SSLMODE=

# True ou False. Pool de conexoes do Postgres (psycopg 3). Ausente, vale True.
#
# O pool mantem conexoes abertas no processo e as empresta a qualquer thread.
# Sem ele o `runserver`, que abre uma thread por requisicao, reabre a conexao
# em toda requisicao - contra o Neon, mais de um segundo antes da primeira
# query. Com o pool ligado o `DB_CONN_MAX_AGE` abaixo e ignorado. A suite nunca
# usa pool.
DB_POOL=

# Segundos que a conexao sobrevive a requisicao (`CONN_MAX_AGE` do Django). So
# vale com `DB_POOL=False`.
#
# Em zero - o padrao do Django - cada requisicao abre e fecha a conexao. Contra
# um Postgres local isso custa quase nada; contra um banco remoto custa
# handshake TCP, TLS e autenticacao no proxy ANTES da primeira query sair, e o
# custo nao aparece em nenhuma linha de codigo.
#
# Ausente, segue o AMBIENTE: 600 em producao, 0 em local. A suite forca 0 em
# qualquer ambiente - conexao viva no fim do teste impede o DROP do banco de
# teste.
#
# Com pooler (o endpoint `-pooler` do Neon e PgBouncer em transaction mode)
# reaproveitar conexao e seguro. Numero.
DB_CONN_MAX_AGE=


# --- JWT ---------------------------------------------------------------------
# Numeros. Referencia: 30 minutos de access, 1 dia de refresh.
JWT_ACCESS_MINUTES=
JWT_REFRESH_DAYS=

# Validade dos links de conta, em horas. O link e de portador: quem o tiver,
# usa. Por isso a janela e curta, e o token queima no primeiro uso.
# Numeros. Referencia: 2 horas para recuperacao, 24 para convite.
TOKEN_RECUPERACAO_HORAS=
TOKEN_CONVITE_HORAS=

# --- Limite de requisicoes ---------------------------------------------------
#
# Trava de forca bruta. Sem ela, `/api/auth/token/` aceita tentativa de senha
# sem fim. Os escopos `login`, `recuperacao` e `redefinicao` valem por rota; os
# limites `anon` e `user` valem para o resto da API.
#
# O contador vive no cache. Sem `CACHES` configurado, o Django usa memoria do
# processo: com varios workers, cada um conta o seu e o limite real vira o valor
# abaixo multiplicado pelo numero de workers. Em producao com mais de um worker,
# aponte `CACHES` para um cache compartilhado.
#
# Formato `<numero>/<periodo>`, com periodo em sec, min, hour ou day.
# Referencia: 60/min, 240/min, 10/min, 5/hour e 10/hour, na ordem abaixo.
THROTTLE_ANON=
THROTTLE_USER=
THROTTLE_LOGIN=
THROTTLE_RECUPERACAO=
THROTTLE_REDEFINICAO=
# Pedidos que chamam a IA (Copiloto, competências, matching e pré-análise), por
# pessoa, somados entre as rotas. Referencia: 30/hour. O limite de gasto por
# oportunidade continua valendo por cima.
THROTTLE_IA=

# Quantos proxies reversos ficam na frente da API. Em 0, o limite conta pelo
# REMOTE_ADDR e o cabecalho X-Forwarded-For e ignorado - que e o certo com a API
# exposta direto, ja que o cliente pode forjar esse cabecalho e escapar da
# trava. Atras de proxy (nginx, load balancer), ponha o numero de saltos.
# Numero.
NUM_PROXIES=

# --- E-mail ------------------------------------------------------------------
#
# O `settings.py` forca locmem durante `manage.py test`, sem excecao: nada
# aqui faz a suite abrir SMTP.
#
# Com o backend `console` o e-mail e impresso no terminal do runserver, com o
# link de redefinicao dentro - e o modo de dev. Com `smtp` ele sai de verdade,
# e aí EMAIL_HOST_USER e EMAIL_HOST_PASSWORD passam a ser obrigatorios.
# Dev: django.core.mail.backends.console.EmailBackend
# Envio real: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
# Gmail: smtp.gmail.com. Outlook/Microsoft 365: smtp.office365.com.
# SendGrid: smtp.sendgrid.net.
EMAIL_HOST=
# Numero. 587 com TLS, 465 com SSL.
EMAIL_PORT=
# True ou False. True na 587.
EMAIL_USE_TLS=
# True ou False. True so na 465. TLS e SSL juntos sao erro: escolha um.
EMAIL_USE_SSL=
# Segundos ate desistir do SMTP. Sem isso, um servidor que pendura pendura a
# request junto. Referencia: 10.
EMAIL_TIMEOUT=
EMAIL_HOST_USER=
# No Gmail e uma senha de app de 16 caracteres, nunca a senha da conta.
# Credencial real: nao versione o `.env`.
EMAIL_HOST_PASSWORD=
# Remetente dos envios. Ex.: nao-responda@seudominio. A maioria dos provedores
# exige que seja igual a EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
# True ou False. Liga o e-mail ao Demandante quando o Supervisor decide
# Revisar, Continuar ou Arquivar (apps/notifications/services/email.py). O
# aviso na plataforma, que existe para o Revisar, sai de qualquer jeito. O
# remetente deve ser uma conta da AC2, a controladora dos dados, e nao uma
# conta pessoal: o provedor guarda copia do que envia. A suite sempre desliga.
SEND_NOTIFICATION_EMAILS=

# Base dos links de recuperacao e de primeiro acesso: o e-mail sai com
# {FRONTEND_URL}/redefinir-senha?token=... Aponte para onde o front esta
# publicado; com localhost, o link so abre na maquina de quem rodou.
# Ex.: http://localhost:5173
FRONTEND_URL=

# Caminho do /admin/ do Django, a ferramenta de suporte (so conta tecnica
# entra). Ausente, vale admin; com AMBIENTE=producao o padrao e recusado e o
# servidor nao sobe. Ex.: painel-tecnico-7f3a
ADMIN_URL=

# --- Busca semantica e matching ----------------------------------------------
#
# Pesos, thresholds e modelo sao CONFIGURACAO, nunca numero magico no codigo
# (AGENTS.md 2.4). Mudar qualquer um deles e portao de decisao (3.2).
# Numero inteiro, casado com o modelo escolhido. Referencia: 384.
SEARCH_EMBEDDING_DIMENSION=
# Referencia: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEARCH_EMBEDDING_MODEL=
# True ou False. Liga a afinidade com o tema (45% da nota do matching), com o
# modelo acima rodando no proprio servidor. Ausente, vale True. A suite sempre
# desliga. O modelo ocupa algumas centenas de MB e leva alguns segundos para
# carregar na primeira rodada do processo. Gere os vetores da rede de uma vez
# com `python manage.py gerar_vetores`.
SEARCH_EMBEDDING_ENABLED=
# Decimais que somam 1.0. Referencia: 0.45, 0.20, 0.25 e 0.10, na ordem abaixo.
AI_MATCH_WEIGHT_SEMANTIC=
AI_MATCH_WEIGHT_LEXICAL=
AI_MATCH_WEIGHT_AREA=
AI_MATCH_WEIGHT_AVAILABILITY=
# Decimal. Abaixo disso a pessoa nao entra na equipe sugerida. Referencia: 0.26.
AI_MATCH_MIN_SCORE=

# Peso de uma competencia `desejavel` frente a uma `essencial` na cobertura.
# Decimal entre 0 e 1. Referencia: 0.5.
AI_MATCH_PESO_DESEJAVEL=
# Maximo de pessoas que uma rodada de matching sugere. Numero. Referencia: 10.
AI_MATCH_LIMITE_SUGESTOES=
# Cobertura minima de uma competencia necessaria para ela NAO virar lacuna da
# equipe sugerida. Decimal. Referencia: 0.2.
AI_MATCH_COBERTURA_MINIMA=
# Fator de disponibilidade, por situacao declarada no perfil. Decimais entre 0 e
# 1, na ordem integral, parcial, pontual, indisponivel.
# Referencia: 1.0, 0.6, 0.3 e 0.
AI_MATCH_DISP_INTEGRAL=
AI_MATCH_DISP_PARCIAL=
AI_MATCH_DISP_PONTUAL=
AI_MATCH_DISP_INDISPONIVEL=

# --- IA generativa -----------------------------------------------------------
#
# Deixe a chave VAZIA em dev e teste. O `settings.py` a zera durante os testes,
# mas o mandato e nao ter chave preenchida em ambiente de desenvolvimento.
GEMINI_API_KEY=
# True ou False. False em dev e teste.
AI_MATCH_RERANK_ENABLED=
# Referencia: gemini-2.5-flash. Vale para as quatro operacoes do gateway -
# Copiloto, competencias, matching e pre-analise - e e o modelo gravado em
# `ExecucaoIA.modelo` e anunciado no painel de saude.
AI_MATCH_GEMINI_MODEL=
# Provedor principal, pelo nome do registro (SPEC-23). Referencia: google.
AI_PROVEDOR_PRINCIPAL=
# Provedor de reserva, pelo nome do registro. Vazio desliga a reserva de
# provedor; o modelo alternativo abaixo ainda pode ser usado.
AI_PROVEDOR_RESERVA=
# Modelo alternativo para a reserva, no mesmo provedor. Vazio usa o modelo
# principal. Referencia: gemini-2.5-flash-lite.
AI_MODELO_RESERVA=
# Temperatura das chamadas. Referencia: 0.3 - baixa, porque as quatro operacoes
# pedem JSON estruturado, nao texto criativo.
AI_GEMINI_TEMPERATURA=
# Teto de tokens de saida por chamada. Referencia: 8192.
AI_GEMINI_MAX_TOKENS_SAIDA=
# Tempo maximo de espera por chamada, em segundos. Referencia: 45. Estourado,
# conta como falha passageira.
AI_GEMINI_TIMEOUT_S=
# Quantas vezes a chamada e feita, contando a primeira, quando a falha e
# passageira (429, 5xx, timeout). Referencia: 2. Erro de requisicao (400, 403)
# nao e repetido.
AI_GEMINI_TENTATIVAS=
# Espera antes da segunda tentativa, em segundos; dobra a cada nova tentativa.
# Referencia: 2.
AI_GEMINI_ESPERA_INICIAL_S=
# Quantos tokens o Gemini 2.5 Flash pode gastar "pensando" antes de responder.
# Referencia: 1024. Menos raciocinio, resposta mais rapida e mais barata; -1
# deixa o modelo decidir, que era o comportamento antes do limite. O tempo com e
# sem limite se mede com `python manage.py medir_estruturacao`.
AI_GEMINI_ORCAMENTO_RACIOCINIO=

# Caminho do JSON da Base de Conhecimento PIPE, de onde saem as perguntas
# orientadoras do Copiloto e os criterios da pre-analise. Ausente, vale
# `IA/Colinha_IA_PIPE_Jornada_Fase1_PD_Connect_v2.json` ao lado do backend.
# Sem o arquivo, as duas telas explicam a ausencia em vez de inventar conteudo.
BASE_CONHECIMENTO_PIPE=

# Percentual do teto a partir do qual a tela de Saude mostra atencao. Numero
# inteiro de 0 a 100. Referencia: 80.
AI_CUSTO_ALERTA_PERCENTUAL=

# Teto de custo mensal em BRL. `execucao_ia` responde quanto ja foi consumido.
# Atingido o teto, a chamada ao provedor nao sai: o gateway cai no fallback e
# grava `teto_de_custo_excedido` na trilha (Metodos_Integracao_IA.md, tabela de
# falhas). Zero desliga o teto. Decimal. Referencia: 50.
AI_CUSTO_TETO_MENSAL_BRL=
# Limite de custo por oportunidade em BRL, somando todas as execucoes dela
# (Plano_Integracao_IA.md: "limite mensal e um limite por oportunidade").
# Atingido, so as chamadas daquela oportunidade caem no fallback, e a trilha
# grava `teto_por_oportunidade_excedido`. Zero desliga. Referencia aprovada pelo
# PO em 24/10/2026: 5 (um decimo do teto mensal).
AI_CUSTO_TETO_POR_OPORTUNIDADE_BRL=

# --- Fila assincrona (opcional, SPEC-14) -------------------------------------
# True liga a pre-analise na fila: o POST responde 202 com status `pendente` e
# o worker conclui. False mantem o caminho sincrono (201), que e o padrao.
PREANALISE_ASSINCRONA=
# Ex.: redis://127.0.0.1:6379/0. No docker compose, use
# redis://redis:6379/0 (o nome do servico). Vazio deixa a fila nao configurada;
# o painel de saude mostra "sem fila" em vez de alarme.
CELERY_BROKER_URL=
# Opcional. Ex.: redis://127.0.0.1:6379/1. Vazio usa o broker.
CELERY_RESULT_BACKEND=
# True executa a tarefa no proprio processo (util para diagnostico local).
# Nunca use True contra um broker real.
CELERY_TASK_ALWAYS_EAGER=

# --- Retencao de dados pessoais (LGPD, SPEC-17) ------------------------------
# Meses que eventos de conta (login, entrada recusada e saida) ficam ligados a
# pessoa. Depois disso, a trilha mantem o fato, mas anonimiza o ator.
# Numero inteiro. Deixe comentado para usar o padrao do settings.py (12).
# RETENCAO_EVENTOS_CONTA_MESES=12
# Meses que anexos de oportunidade ficam guardados depois da decisao de
# arquivamento. Vencido o prazo, linha e arquivo fisico sao descartados.
# Numero inteiro. Deixe comentado para usar o padrao do settings.py (24).
# RETENCAO_ANEXOS_MESES=24

# Tabela de preco do provedor, em BRL por milhao de tokens. Alimenta a formula
# de Plano_Integracao_IA.md (secao Controle de custo):
#   custo = entrada/1e6 * preco_entrada + saida/1e6 * preco_saida
#
# **Sem referencia na baseline, e por isso nascem em zero.** Preco de provedor
# muda sem avisar o repositorio, e numero magico aqui vira fatura errada
# (AGENTS.md 2.4). Enquanto estiverem em zero, nenhuma execucao apura custo e a
# tela de Saude declara "sem apuracao" em vez de afirmar R$ 0,00. Preencher com
# a tabela vigente do provedor e portao de decisao do PO (AGENTS.md 3.2).
#
# Sem tabela, os limites de gasto tambem nao bloqueiam nada: o custo de cada
# chamada fica sem valor e nunca soma ate o teto.
#
# Referencia aprovada pelo PO em 24/10/2026, para gemini-2.5-flash: 1.5113 na
# entrada e 12.5943 na saida. Sao US$ 0,30 e US$ 2,50 por milhao de tokens
# (https://ai.google.dev/gemini-api/docs/pricing) convertidos pela PTAX de venda
# de 23/10/2026, R$ 5,0377 (Banco Central). Trocou o modelo ou o cambio mudou
# muito: recalcule e registre em IA/PARAMETROS_VIGENTES.md.
AI_CUSTO_ENTRADA_BRL_POR_MILHAO=
AI_CUSTO_SAIDA_BRL_POR_MILHAO=
