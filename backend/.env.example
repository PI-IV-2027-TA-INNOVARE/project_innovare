# =============================================================================
# P&D Connect - backend (Django)
#
# Copie para `.env` e preencha. O `.env` NUNCA entra no git (AGENTS.md 0.1):
# ele carrega credenciais reais de banco, SMTP e IA. Este arquivo, sim, e
# versionado - portanto nao coloque nenhum valor real aqui.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Gere com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-chave-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# Origens do front autorizadas a chamar a API (Vite sobe em 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Banco de dados ----------------------------------------------------------
#
# DESENVOLVIMENTO E TESTE: PostgreSQL LOCAL. Mandato AGENTS.md 0.1 - a suite de
# testes cria e destroi um banco `test_<DB_NAME>`; apontada para um host remoto
# ela criaria e dropparia um banco de verdade na conta do cliente. O
# `settings.py` tem uma trava que troca para SQLite em memoria se detectar
# teste com DB_HOST remoto, mas a trava e a ultima linha de defesa, nao a
# primeira: mantenha DB_HOST local no dia a dia.
DB_NAME=pdconnect
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# Para apontar ao Neon (ambiente compartilhado), troque o bloco acima por:
#   DB_NAME=neondb
#   DB_USER=<usuario do Neon>
#   DB_PASSWORD=<senha do Neon>
#   DB_HOST=<endpoint>.neon.tech
#   DB_PORT=5432
#   DB_SSLMODE=require
# Neon exige TLS e responde na 5432. Redes que bloqueiam essa porta de saida
# dao `timeout expired` na conexao - ver README, secao "Banco".

# --- JWT ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Validade dos links de conta, em horas.
TOKEN_RECUPERACAO_HORAS=24
TOKEN_CONVITE_HORAS=168

# --- E-mail ------------------------------------------------------------------
#
# Em dev e teste use o backend de console. SMTP real so em producao - e o
# `settings.py` forca locmem durante `manage.py test`, sem excecao.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=nao-responda@pdconnect.local
SEND_NOTIFICATION_EMAILS=False

# URL do front, usada para montar os links de recuperacao e de primeiro acesso.
FRONTEND_URL=http://localhost:5173

# --- Busca semantica e matching ----------------------------------------------
#
# Pesos, thresholds e modelo sao CONFIGURACAO, nunca numero magico no codigo
# (AGENTS.md 2.4). Mudar qualquer um deles e portao de decisao (3.2).
SEARCH_EMBEDDING_DIMENSION=384
SEARCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_MATCH_WEIGHT_SEMANTIC=0.45
AI_MATCH_WEIGHT_LEXICAL=0.20
AI_MATCH_WEIGHT_AREA=0.25
AI_MATCH_WEIGHT_AVAILABILITY=0.10
AI_MATCH_MIN_SCORE=0.26

# --- IA generativa -----------------------------------------------------------
#
# Deixe a chave VAZIA em dev e teste. O `settings.py` a zera durante os testes,
# mas o mandato e nao ter chave preenchida em ambiente de desenvolvimento.
GEMINI_API_KEY=
AI_MATCH_RERANK_ENABLED=False
AI_MATCH_GEMINI_MODEL=gemini-2.5-flash

# Teto de custo mensal em BRL. `execucao_ia` responde quanto ja foi consumido.
AI_CUSTO_TETO_MENSAL_BRL=50
